# PostgreSQL/Tiger Data. The database must have the pgvector extension available.
# Standard provider URLs beginning with postgresql:// are accepted and converted
# automatically to the Psycopg 3 SQLAlchemy dialect.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Must match the embedding model used when creating skill embeddings. Changing
# this after embeddings exist requires re-indexing them.
EMBEDDING_DIMENSIONS=1536
DATABASE_ECHO=false

# Local frontend origin used by the FastAPI CORS middleware.
FRONTEND_HOST=http://localhost:3000
FASTAPI_ENV=development

# Browser Use Cloud key for interactive guided-browser sessions. Keep the real
# value in .env only; never expose it to the frontend.
BROWSER_USE_API_KEY=

# ElevenLabs key for user-consented voice preservation and text-to-speech.
# Keep the real value server-side in .env only.
ELEVENLABS_API_KEY=
VOICE_SAMPLE_MAX_BYTES=10000000
# Generate once with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VOICE_SAMPLE_ENCRYPTION_KEY=

# Browser-safe Appwrite configuration used for magic-link sign-in and the
# Persona Function invocation. Set these in frontend/.env.local.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=Aide
NEXT_PUBLIC_PERSONA_FUNCTION_ID=6aa5c87b0020263855b6
